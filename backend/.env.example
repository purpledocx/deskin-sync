# main PostgreSQL connection string used by the app; required, startup fails without it
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/deskin_sync

# separate DB for the tests; must contain "deskin_sync_test" or tests refuse to run
TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/deskin_sync_test

# secret used to sign JWT access tokens; required.
# generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-long-random-string

# signing algorithm for JWT tokens; default - HS256 when unset
JWT_ALGORITHM=HS256

# lifetime of access token in minutes; default - 60 when unset
ACCESS_TOKEN_EXPIRES_MINUTES=60

# password assigned to demo users created by seeder.py; only the seeder reads it
DEMO_PASSWORD=123123123
